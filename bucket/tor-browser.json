{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "##": "Multiple components under various open source licenses. Included HTTPS Everywhere extension is the strictest.",
    "version": "15.0.25",
    "description": "Web browser that connects to the internet via the Tor anonymity network",
    "homepage": "https://www.torproject.org/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://archive.torproject.org/tor-package-archive/torbrowser/15.0.25/tor-browser-windows-x86_64-portable-15.0.25.exe",
            "hash": "948f79f7312c7b62dffeb1d65a51d49ea6bcb22b47b271fdd2edee9d5e22d561"
        },
        "32bit": {
            "url": "https://archive.torproject.org/tor-package-archive/torbrowser/15.0.25/tor-browser-windows-i686-portable-15.0.25.exe",
            "hash": "06ebb5051cd074e0cab2c1cdfad453a2212c8be286a70a7030744550b11c8863"
        }
    },
    "pre_install": [
        "# Rename downloaded file",
        "Rename-Item -Path \"$dir\\tor-browser-*.exe\" -NewName \"installer.exe\"",
        "# Extract as 7-Zip archive",
        "Expand-7zipArchive -Path \"$dir\\installer.exe\" -DestinationPath \"$dir\\_temp\"",
        "# Move content to $dir",
        "movedir -from \"$dir\\_temp\\Browser\" -to \"$dir\"",
        "# Update extensions in persisted profile",
        "movedir -from \"$dir\\TorBrowser\\Data\\Browser\\profile.default\" -to \"$persist_dir\\TorBrowser\\Data\\Browser\\profile.default\"",
        "# Delete _temp",
        "Remove-Item -Force -Recurse -Path \"$dir\\_temp\""
    ],
    "bin": [
        [
            "firefox.exe",
            "tor-browser"
        ]
    ],
    "shortcuts": [
        [
            "firefox.exe",
            "Tor Browser"
        ]
    ],
    "persist": [
        "TorBrowser\\Data\\Browser\\profile.default",
        "TorBrowser\\Data\\Tor"
    ],
    "checkver": {
        "url": "https://aus1.torproject.org/torbrowser/update_3/release/downloads.json",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.torproject.org/tor-package-archive/torbrowser/$version/tor-browser-windows-x86_64-portable-$version.exe"
            },
            "32bit": {
                "url": "https://archive.torproject.org/tor-package-archive/torbrowser/$version/tor-browser-windows-i686-portable-$version.exe"
            }
        },
        "hash": {
            "url": "$baseurl/sha256sums-signed-build.txt"
        }
    }
}
