{
    "version": "5.6.3-5142",
    "description": "纯粹直播: 一个应用看遍 34 个直播平台和网络电视. 弹幕、录制、多画面、小窗和后台播放, Android、电视、Windows、Linux.",
    "homepage": "https://github.com/wzgrx/PureLive",
    "license": "AGPL-3.0-only",
    "notes": "数据保存在 Scoop 的 persist 目录 (UserData 内含关注、设置、历史和登录)。开机启动项在卸载时移除, 重装或更新后按新路径恢复。程序内会提示新版本, 其中的下载并安装会运行上游安装包并装到单独位置; 请不要用它更新, 改用 scoop update purelive 升级。关闭窗口可能只是隐藏到托盘, 更新或卸载前请从托盘退出程序。",
    "architecture": {
        "64bit": {
            "url": "https://github.com/wzgrx/PureLive/releases/download/v5.6.3/PureLive-5.6.3-5142-windows-x64-portable.zip",
            "hash": "fd67a94558a62d7e31c123c45bd1b325f1060105bb159cadce766b44abc68223"
        }
    },
    "persist": "UserData",
    "post_install": [
        "$run = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "$approved = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run'",
        "$mark = \"$persist_dir\\autostart\"",
        "if (Test-Path $mark) {",
        "    New-ItemProperty $run -Name 'PureLiveV4' -Value ('\"{0}\"' -f \"$dir\\pure_live.exe\") -PropertyType String -Force | Out-Null",
        "    if (Test-Path \"$mark-approved\") {",
        "        if (!(Test-Path $approved)) { New-Item $approved | Out-Null }",
        "        $bytes = [byte[]]@((Get-Content \"$mark-approved\" -Raw).Trim() -split ',')",
        "        New-ItemProperty $approved -Name 'PureLiveV4' -Value $bytes -PropertyType Binary -Force | Out-Null",
        "    }",
        "    Remove-Item $mark, \"$mark-approved\" -Force -ErrorAction SilentlyContinue",
        "}"
    ],
    "post_uninstall": [
        "$run = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "$approved = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run'",
        "$backup = ensure $persist_dir",
        "Remove-Item \"$backup\\autostart*\" -Force -ErrorAction SilentlyContinue",
        "if (Get-ItemProperty $run -Name 'PureLiveV4' -ErrorAction SilentlyContinue) {",
        "    Set-Content \"$backup\\autostart\" '1'",
        "    if ($value = Get-ItemProperty $approved -Name 'PureLiveV4' -ErrorAction SilentlyContinue) { Set-Content \"$backup\\autostart-approved\" ($value.PureLiveV4 -join ',') }",
        "}",
        "Remove-ItemProperty $run -Name 'PureLiveV4' -ErrorAction SilentlyContinue",
        "Remove-ItemProperty $approved -Name 'PureLiveV4' -ErrorAction SilentlyContinue"
    ],
    "shortcuts": [
        [
            "pure_live.exe",
            "纯粹直播"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/wzgrx/PureLive/releases/latest",
        "jsonpath": "$.assets[*].name",
        "regex": "PureLive-((?<tag>[\\d.]+)-(?<build>\\d+))-windows-x64-portable\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/wzgrx/PureLive/releases/download/v$matchTag/PureLive-$version-windows-x64-portable.zip"
            }
        }
    }
}
